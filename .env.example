# Copy to .env and fill in values for this machine:
#   copy .env.example .env
#
# Both ways of running read this file:
#   - Docker Compose reads it automatically.
#   - "python web_server.py" reads it too (real environment variables win).


# ---------------------------------------------------------------------------
# Running locally (python web_server.py)
# ---------------------------------------------------------------------------

# Where MP3s are saved. Songs are filed under <OUTPUT_DIR>/<Artist>/<Album>/.
# Leave unset to use the "downloads" folder next to web_server.py.
# Windows paths work as-is — no quotes or doubled backslashes needed:
#   OUTPUT_DIR=D:\Music
#   OUTPUT_DIR=C:\Users\onion\Music
# OUTPUT_DIR=

# Address to listen on. Unset = your Tailscale IP if Tailscale is running,
# otherwise 127.0.0.1 only. Use 127.0.0.1 to reach it at localhost:8787,
# or 0.0.0.0 to reach it from any device on your network.
# BIND_HOST=127.0.0.1

# PORT=8787

# Ignored when BIND_HOST is 127.0.0.1. Set to 0 if you bind to 0.0.0.0 and
# want to reach the UI from a device that is not on your tailnet.
# REQUIRE_TAILSCALE_CLIENT=1


# ---------------------------------------------------------------------------
# Docker only (ignored when running locally)
# ---------------------------------------------------------------------------

# From: tailscale ip -4
# Publishes the port only on this IP. Unset = 0.0.0.0 (all interfaces).
TAILSCALE_IP=100.x.x.x

# Where MP3s are saved on the HOST PC.
# Docker mounts this folder to /data inside the container.
# After changing this value, recreate the container so the mount updates:
#   docker compose up -d --force-recreate
#
# Examples (forward slashes work best on Windows + Docker Desktop):
#   HOST_DOWNLOAD_DIR=./downloads
#   HOST_DOWNLOAD_DIR=D:/Music
#   HOST_DOWNLOAD_DIR=C:/Users/onion/Music
HOST_DOWNLOAD_DIR=./downloads
